# Safe defaults. Copy to .env for Docker Compose, or set environment variables
# before a direct uvicorn launch. scripts/start.ps1 always uses the mock provider.
PROVIDER=mock
PUBLIC_DEMO=false
DATABASE_PATH=.runtime/turning-point.sqlite3
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MODEL_TIMEOUT_SECONDS=3
MOCK_FAILURE=none
FIXTURE_CORRECTION=0

# Optional Microsoft Foundry adapter. No resources or model calls are made
# by the default mock path. Do not enable without approved existing resources,
# an approved cost limit, and separately supplied local Azure authentication.
MICROSOFT_INFERENCE_APPROVED=false
MICROSOFT_MAX_CALLS=0
MICROSOFT_MAX_OUTPUT_TOKENS=1800
MICROSOFT_PROJECT_ENDPOINT=
MICROSOFT_MODEL_DEPLOYMENT=

# Public hosting is configured explicitly in docker-compose.production.yml.
# Keep the native/local path separate; no Azure keys or account credentials are
# required by the deployed public mock demo.
